#!/bin/bash
# Native macOS agent-worker launcher (the runtime's AGENT_WORKER_COMMAND under vexa-daemon).
#
# The same program as the agent-worker image (`python -m worker`), run from the image layout that
# vexa-daemon builds below runtime/apps/agent-worker, in its locked environment, with the pinned
# claude-code and codex CLIs from runtime/node-tools.
#
# The image sets HOME=/tmp and a managed claude-code settings file that turns hooks and
# non-essential traffic off. Here each worker gets a private, empty HOME (so no user settings or
# hooks apply) and CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1. The worker runs as the Mac user:
# the image's separate tools user does not exist on the host.
set -u

runtime="$HOME/Library/Application Support/Vexa/runtime"
app="$runtime/apps/agent-worker/app"
if [ ! -d "$app" ]; then
    echo "[vexa-agent-worker] $app is missing; start the native stack first" >&2
    exit 1
fi
work="$(mktemp -d "${TMPDIR:-/tmp}/vexa-worker.XXXXXX")" || exit 1
export HOME="$work"
mkdir -p "$HOME/.codex"
export PATH="$runtime/node-tools/node_modules/.bin:$runtime/venvs/agent-worker/bin:$PATH"
export PYTHONPATH="$app"
export PYTHONUNBUFFERED=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export VEXA_WORKSPACE_SEEDS_DIR="${VEXA_WORKSPACE_SEEDS_DIR:-$app/workspace-seeds}"
export VEXA_TOOLS_SEED_DIR="${VEXA_TOOLS_SEED_DIR:-$app/tools-seed}"

cd "$app" || exit 1
python -m worker &
worker=$!
trap 'kill -TERM "$worker" 2>/dev/null' TERM INT
status=0
while kill -0 "$worker" 2>/dev/null; do
    wait "$worker"
    status=$?
done
rm -rf "$work"
exit "$status"
